generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====================== ENUMS ======================
enum UserRole {
  ADMIN
  RESPONSABLE_MASTER
  ENSEIGNANT
  ETUDIANT
}

// ====================== MODELS ======================

model User {
  id                   String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nom                  String                @db.VarChar(100)
  prenom               String                @db.VarChar(100)
  email                String                @unique @db.VarChar(150)
  mot_de_passe         String                @db.VarChar(255)
  role                 String                @db.VarChar(30)
  actif                Boolean?              @default(true)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)

  students             Student?
  teachers             Teacher?
  observations         Observation[]
  defense_observations DefenseObservation[]

  @@map("users")
}

model Teacher {
  id                                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                            String   @unique @db.Uuid
  grade                              String   @db.VarChar(50)
  specialite                         String?  @db.VarChar(150)

  user                               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  subjectsAsEncadrant                Subject[] @relation("subjects_encadrant_idToteachers")
  subjectsAsSuperviseur              Subject[] @relation("subjects_superviseur_idToteachers")
  jury_members                       JuryMember[]

  @@map("teachers")
}

model Student {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @unique @db.Uuid
  matricule   String   @unique @db.VarChar(50)
  promotion   String?  @db.VarChar(50)
  master      String?  @db.VarChar(100)

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  applications Application[]
  memoires    Memoire?

  @@map("students")
}

model AcademicYear {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  libelle     String    @db.VarChar(20)
  date_debut  DateTime  @db.Date
  date_fin    DateTime  @db.Date
  statut      String?   @default("en_cours") @db.VarChar(20)

  semesters   Semester[]

  @@map("academic_years")
}

model Semester {
  id                        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  academic_year_id          String   @db.Uuid
  libelle                   String   @db.VarChar(50)
  date_limite_sujets        DateTime? @db.Date
  date_limite_candidatures  DateTime? @db.Date
  date_limite_documents     DateTime? @db.Date
  statut                    String?  @default("ferme") @db.VarChar(20)

  academic_years   AcademicYear    @relation(fields: [academic_year_id], references: [id])
  subjects         Subject[]
  defense_sessions DefenseSession[]

  @@map("semesters")
}

model Subject {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  titre                 String   @db.VarChar(255)
  resume                String?
  objectifs             String?
  competences_requises  String?
  mots_cles             String?  @db.VarChar(255)
  encadrant_id          String   @db.Uuid
  superviseur_id        String   @db.Uuid
  semester_id           String   @db.Uuid
  capacite              Int?     @default(1)
  statut                String?  @default("brouillon") @db.VarChar(20)

  teachers_encadrant   Teacher   @relation("subjects_encadrant_idToteachers", fields: [encadrant_id], references: [id])
  teachers_superviseur Teacher   @relation("subjects_superviseur_idToteachers", fields: [superviseur_id], references: [id])
  semesters            Semester  @relation(fields: [semester_id], references: [id])

  applications Application[]
  memoires     Memoire?

  @@map("subjects")
}

model Application {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id       String   @db.Uuid
  subject_id       String   @db.Uuid
  motivation       String?
  date_candidature DateTime? @default(now()) @db.Timestamp(6)
  statut           String?  @default("en_attente") @db.VarChar(20)

  students Student @relation(fields: [student_id], references: [id])
  subjects Subject @relation(fields: [subject_id], references: [id])

  @@unique([student_id, subject_id])
  @@map("applications")
}

model Memoire {
  id                            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id                    String   @unique @db.Uuid
  subject_id                    String   @unique @db.Uuid
  date_affectation              DateTime? @default(now()) @db.Timestamp(6)
  statut_avancement             String?  @default("en_cours") @db.VarChar(20)
  soutenable                    Boolean? @default(false)
  date_validation_soutenabilite DateTime? @db.Timestamp(6)

  students     Student     @relation(fields: [student_id], references: [id])
  subjects     Subject     @relation(fields: [subject_id], references: [id])
  documents    Document[]
  milestones   Milestone[]
  observations Observation[]
  defenses     Defense?

  @@map("memoires")
}

model Document {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoire_id       String   @db.Uuid
  type             String?  @db.VarChar(50)
  nom_fichier      String   @db.VarChar(255)
  chemin_stockage  String   @db.VarChar(500)
  version          Int?     @default(1)
  date_depot       DateTime? @default(now()) @db.Timestamp(6)

  memoires Memoire @relation(fields: [memoire_id], references: [id], onDelete: Cascade)

  @@map("documents")
}

model DefenseSession {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  libelle       String?  @db.VarChar(150)
  date_session  DateTime @db.Date
  heure_debut   DateTime @db.Time(6)
  heure_fin     DateTime @db.Time(6)
  salle         String?  @db.VarChar(100)
  semester_id   String   @db.Uuid
  statut        String?  @default("planifiee") @db.VarChar(20)

  semesters Semester @relation(fields: [semester_id], references: [id])
  defenses  Defense[]

  @@map("defense_sessions")
}

model Defense {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoire_id        String   @unique @db.Uuid
  session_id        String   @db.Uuid
  tenue_effective   Boolean? @default(false)
  statut            String?  @default("programmee") @db.VarChar(20)
  date_heure        DateTime? @db.Timestamp(6)

  memoires            Memoire             @relation(fields: [memoire_id], references: [id])
  defense_sessions    DefenseSession      @relation(fields: [session_id], references: [id])
  defense_observations DefenseObservation[]
  grades              Grade?
  juries              Jury?

  @@map("defenses")
}

model Jury {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  defense_id   String       @unique @db.Uuid

  defenses     Defense      @relation(fields: [defense_id], references: [id])
  jury_members JuryMember[]

  @@map("juries")
}

model JuryMember {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jury_id       String @db.Uuid
  teacher_id    String @db.Uuid
  role_dans_jury String @db.VarChar(30)

  juries   Jury    @relation(fields: [jury_id], references: [id], onDelete: Cascade)
  teachers Teacher @relation(fields: [teacher_id], references: [id])

  @@unique([jury_id, teacher_id])
  @@map("jury_members")
}

model Grade {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  defense_id         String   @unique @db.Uuid
  note_document      Decimal? @db.Decimal(4, 2)
  note_travail       Decimal? @db.Decimal(4, 2)
  note_presentation  Decimal? @db.Decimal(4, 2)
  note_reponses      Decimal? @db.Decimal(4, 2)
  note_finale        Decimal  @db.Decimal(4, 2)
  mention            String?  @db.VarChar(30)
  commentaires       String?
  validee            Boolean? @default(false)
  date_saisie        DateTime? @default(now()) @db.Timestamp(6)

  defenses Defense @relation(fields: [defense_id], references: [id])

  @@map("grades")
}

model Observation {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoire_id         String   @db.Uuid
  auteur_id          String   @db.Uuid
  contenu            String
  type_observation   String?  @db.VarChar(30)
  date_observation   DateTime? @default(now()) @db.Timestamp(6)

  users    User    @relation(fields: [auteur_id], references: [id])
  memoires Memoire @relation(fields: [memoire_id], references: [id], onDelete: Cascade)

  @@map("observations")
}

model Milestone {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoire_id String   @db.Uuid
  libelle    String   @db.VarChar(150)
  echeance   DateTime? @db.Date
  statut     String?  @default("a_faire") @db.VarChar(20)

  memoires Memoire @relation(fields: [memoire_id], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model DefenseObservation {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  defense_id  String   @db.Uuid
  auteur_id   String   @db.Uuid
  contenu     String
  critere     String?  @db.VarChar(50)

  users    User    @relation(fields: [auteur_id], references: [id])
  defenses Defense @relation(fields: [defense_id], references: [id], onDelete: Cascade)

  @@map("defense_observations")
}